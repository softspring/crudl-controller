{
    "name": "softspring/crudl-controller",
    "description": "A CRUD+list helper classes",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "softspring/doctrine-paginator": "^6.0@dev",
        "softspring/doctrine-query-filters": "^6.0@dev",
        "softspring/events": "^6.0@dev"
    },
    "require-dev": {
        "doctrine/orm": "^2.5 | ^3.0",
        "ergebnis/composer-normalize": "^2.50",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpmd/phpmd": "dev-master",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.2",
        "symfony/console": "^6.4|^7.4|^8.0",
        "symfony/dependency-injection": "^6.4|^7.4|^8.0",
        "symfony/form": "^6.4|^7.4|^8.0",
        "symfony/framework-bundle": "^6.4|^7.4|^8.0",
        "symfony/security-core": "^6.4|^7.4|^8.0",
        "symfony/twig-bridge": "^6.4|^7.4|^8.0",
        "symfony/workflow": "^6.4|^7.4|^8.0",
        "symfony/yaml": "^6.4|^7.4|^8.0",
        "twig/twig": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\CrudlController\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\Component\\CrudlController\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "scripts": {
        "fix": [
            "vendor/bin/rector process src tests",
            "vendor/bin/php-cs-fixer fix --diff",
            "composer normalize"
        ],
        "run-tests" : [
            "composer validate --strict --no-check-lock --ansi",
            "XDEBUG_MODE=coverage vendor/bin/phpunit",
            "vendor/bin/rector process src tests --dry-run",
            "vendor/bin/phpstan analyse src tests --level 5",
            "vendor/bin/php-cs-fixer fix --dry-run --diff",
            "vendor/bin/yaml-lint .github/ -vvv --parse-tags",
            "vendor/bin/yaml-lint config/ -vvv --parse-tags",
            "vendor/bin/yaml-lint translations/ -vvv --parse-tags"
        ],
        "test": [
            "composer update --no-scripts --ansi",
            "@run-tests"
        ],
        "test-bc": [
            "composer update --no-scripts --ansi --prefer-lowest --prefer-stable",
            "@run-tests"
        ]
    }
}

