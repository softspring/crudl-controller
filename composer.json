{
    "name": "softspring/crudl-controller",
    "description": "A CRUD+list helper classes",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "softspring/doctrine-paginator": "^6.0@dev",
        "softspring/doctrine-query-filters": "^6.0@dev",
        "softspring/events": "^6.0@dev"
    },
    "require-dev": {
        "doctrine/orm": "^2.5 | ^3.0",
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpmd/phpmd": "dev-master",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5.5",
        "rector/rector": "^1.0",
        "symfony/console": "^6.4|^7.3",
        "symfony/dependency-injection": "^6.4|^7.3",
        "symfony/form": "^6.4|^7.3",
        "symfony/framework-bundle": "^6.4|^7.3",
        "symfony/security-core": "^6.4|^7.3",
        "symfony/twig-bridge": "^6.4|^7.3",
        "symfony/workflow": "^6.4|^7.3",
        "symfony/yaml": "^6.4|^7.3",
        "twig/twig": "^2.10|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\CrudlController\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\Component\\CrudlController\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
